# Railway PostgreSQL servisi baglandiginda otomatik saglanir.
DATABASE_URL="postgresql://user:pass@localhost:5432/youhavemi_pro"

# Kullanici istegi: telefon/API anahtari hash'leme icin gizli anahtarlar.
API_KEY_HASH_SECRET="uzun-rastgele-bir-deger-uret"
PHONE_HASH_SECRET="uzun-rastgele-bir-deger-uret"

# Kullanici istegi: mesaj govdesi sifreleme anahtari (AES-256-GCM).
ENCRYPTION_SECRET="uzun-rastgele-bir-deger-uret"

# Kullanici istegi: yeni kiraci olusturma gibi platform-seviyesi
# islemler icin admin anahtari.
ADMIN_SECRET="uzun-rastgele-bir-deger-uret"

PORT=4001
